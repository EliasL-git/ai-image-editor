# --------------------------------------------------------------------------
# API (apps/api) — also used by Render blueprint (ai-image-editor-api)
# --------------------------------------------------------------------------
PORT=8080
JWT_SECRET=replace-with-a-long-random-string
DATA_DIR=./data

# Modal service URLs (deploy services/modal first, then fill these in)
MODAL_SAM_URL=https://your-workspace--sam2-segment.modal.run
MODAL_FLUX_URL=https://your-workspace--flux-kontext-edit.modal.run
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# CORS / web origin
CORS_ORIGIN=
WEB_ORIGIN=
API_INTERNAL_URL=

# Upload limits
MAX_UPLOAD_MB=15

# --------------------------------------------------------------------------
# Web (apps/web) — the VITE_ vars are baked in at build time
# --------------------------------------------------------------------------
VITE_API_URL=
